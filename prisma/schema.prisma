// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  emailVerified      DateTime?
  name               String?
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  accounts           Account[]
  sessions           Session[]
  workspaces         WorkspaceMember[]
  defaultWorkspaceId String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  
  gardens     Garden[]
  members     WorkspaceMember[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner") // owner, member
  joinedAt    DateTime @default(now())
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([workspaceId, userId])
}

model Garden {
  id            String   @id @default(cuid())
  name          String
  rows          Int
  columnsPerRow Int      // Default columns per row for UI
  workspaceId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plants        Plant[]
}

model Plant {
  id                String   @id @default(cuid())
  name              String
  species           String?
  location          String?   // Legacy text field
  gardenId          String?   // Renamed from shelfId
  gardenRow         Int?      // Renamed from shelfRow
  gardenColumn      Int?      // Renamed from shelfColumn
  plantedDate       DateTime
  status            String   @default("seedling")
  notes             String?
  
  // OpenFarm data
  openFarmId        String?
  openFarmData      String?  // JSON string with cached OpenFarm data
  daysToGermination Int?
  daysToHarvest     Int?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  garden            Garden?  @relation(fields: [gardenId], references: [id], onDelete: SetNull)
  photos            Photo[]
  nfcTags           NfcTag[]
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())
  
  plant     Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  plantId   String
}

model NfcTag {
  id        String   @id @default(cuid())
  uuid      String   @unique
  plantId   String?  // Nullable so tags can be unassigned
  label     String?  // Optional label like "Basil #1 Tag"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  plant     Plant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)
}
